# Copy this file to .env only to change a default value. All lines are optional.
# Host ports. Change a port if another program already uses it:
APP_PORT=8501
APP_METRICS_PORT=28000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
# 0.0.0.0 = other computers can connect (for a VPS). 127.0.0.1 = only this computer can connect.
BIND_ADDR=0.0.0.0
# Grafana admin password. The default is admin. Set your own password on a public server.
GRAFANA_ADMIN_PASSWORD=admin
